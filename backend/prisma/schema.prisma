// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario{
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  email             String
  senha             String
  usuario_simulados Usuario_simulado[]
}

model Usuario_simulado{
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId         String   @db.ObjectId
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  simuladoId        String   @db.ObjectId
  simulado          Simulado @relation(fields: [simuladoId], references: [id], onDelete: NoAction)

  resposta          Resposta[]
}

model Simulado {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  instituicao       String
  simulado_usuario  Usuario_simulado[]
  questoes          Questao[]
}

model Questao {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId 
  corpo             String
  simuladoId        String   @db.ObjectId
  simulado          Simulado @relation(fields: [simuladoId], references: [id], onDelete: NoAction)
  alternativa       Alternativa[]    
}

type Resposta{
  questaoId         String @db.ObjectId
  alternativaId     String @db.ObjectId
}

model Alternativa {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId 
  corpo             String
  questaoId         String   @db.ObjectId
  questao           Questao @relation(fields: [questaoId], references: [id], onDelete: NoAction)
  isCorreta         Boolean
}

model Aluno {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  cpf               String   @unique
  dataDeNascimento  DateTime
  estudanteDaUtfpr  Boolean
  curso             String
  periodo           Int
  ra                String
  endereco          String
  cidade            String
  estado            String
  telefone          String
  email             String   @unique
}

model Termo {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  instituicao               String
  campus                    String
  tituloDaAcao              String
  modalidade                String
  dataDeInicio              DateTime
  dataDeTermino             DateTime
  nomeCoordenacao           String
  cpfCoordenacao            String
  departamento              String
  telefoneCoordenacao       String
  emailCoordenacao          String
  atividadesParaDesenvolver String[]
  condicoesGerais           Json
}